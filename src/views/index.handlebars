<div class="rounded-xl bg-white p-6 shadow-md">
    <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-bold">Usuarios</h1>
        <span class="rounded-full bg-emerald-100 px-3 py-1 text-sm font-medium text-emerald-700">
            Página {{page}} de {{totalPages}}
        </span>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase text-slate-500">
                <tr>
                    <th class="px-4 py-3">Nombre</th>
                    <th class="px-4 py-3">Apellido</th>
                    <th class="px-4 py-3">Email</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {{#each users}}
                    <tr class="hover:bg-slate-50">
                        <td class="px-4 py-3 font-medium">{{first_name}}</td>
                        <td class="px-4 py-3">{{last_name}}</td>
                        <td class="px-4 py-3 text-slate-500">{{email}}</td>
                    </tr>
                {{else}}
                    <tr>
                        <td colspan="3" class="px-4 py-8 text-center text-slate-400">No hay usuarios cargados</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    </div>

    <div class="mt-6 flex items-center justify-between">
        {{#if hasPrevPage}}
            <a href="{{prevLink}}" class="rounded-lg bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700">&laquo; Anterior</a>
        {{else}}
            <span class="cursor-not-allowed rounded-lg bg-slate-200 px-4 py-2 text-sm text-slate-400">&laquo; Anterior</span>
        {{/if}}

        {{#if hasNextPage}}
            <a href="{{nextLink}}" class="rounded-lg bg-slate-900 px-4 py-2 text-sm text-white hover:bg-slate-700">Siguiente &raquo;</a>
        {{else}}
            <span class="cursor-not-allowed rounded-lg bg-slate-200 px-4 py-2 text-sm text-slate-400">Siguiente &raquo;</span>
        {{/if}}
    </div>
</div>
